<?php
require __DIR__.'/bootstrap.php'; require_perm('invoices.view');
$invoiceId=(int)($_GET['id']??0);
if(!$invoiceId && isset($_GET['shipment_id'])){
    $s=$pdo->prepare('SELECT id FROM shipment_invoices WHERE shipment_id=? ORDER BY id DESC LIMIT 1');$s->execute([(int)$_GET['shipment_id']]);$invoiceId=(int)$s->fetchColumn();
}
$q=$pdo->prepare('SELECT i.*,s.awb,s.shipment_date,s.sender,s.tell,s.receiver,s.description,s.pcs,s.kg,s.rate,s.extra,s.paid_dxb,ob.name origin_branch,tb.name dest_branch,i.status invoice_status FROM shipment_invoices i JOIN shipments s ON s.id=i.shipment_id JOIN branches ob ON ob.id=s.branch_id LEFT JOIN branches tb ON tb.id=s.to_branch_id WHERE i.id=?');$q->execute([$invoiceId]);$r=$q->fetch();
if(!$r){http_response_code(404);exit('Invoice not found.');}
$company=setting('company_name','CargoSom');$tagline=setting('company_tagline','Cargo Agency');$logo=setting('logo_path');$address=setting('company_address','');
$discount=(float)($r['discount_amount']??0);$invoiceTotal=(float)$r['total']+(float)$r['extra'];$paid=min((float)$r['paid_dxb'],$invoiceTotal);$balance=max(0,$invoiceTotal-$paid);$qr=$address?'https://api.qrserver.com/v1/create-qr-code/?size=120x120&data='.rawurlencode($address):'';
?>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><?=e($r['invoice_no'])?></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#eef4fa;color:#243b53}.tools,.sheet{max-width:850px;margin:auto}.tools{padding:24px 0 0;text-align:right}.sheet{margin-top:16px;margin-bottom:35px;background:#fff;padding:52px;border-top:7px solid #1363df;box-shadow:0 18px 50px #102a4320;border-radius:16px}.logo{max-width:180px;max-height:80px;object-fit:contain}.mark{display:grid;place-items:center;width:62px;height:62px;border-radius:16px;background:#1363df;color:#fff;font-weight:800}.meta{background:#f5f9fd;border:1px solid #dce8f3;border-radius:12px;padding:14px;line-height:1.7}.table thead th,.total{background:#102a43!important;color:#fff!important}.table td,.table th{padding:14px}.discount th{color:#b02a37}.qr{margin-top:30px;text-align:right}.qr img{width:96px;height:96px}.footer{margin-top:35px;padding-top:16px;border-top:1px solid #dce7f2;color:#6b7d90;font-size:.85rem;display:flex;justify-content:space-between}.statusline{display:inline-block;padding:3px 10px;border-radius:999px;background:#eef4fb;border:1px solid #d3e2f5;font-size:.72rem;color:#46586e}@media print{body{background:#fff}.tools{display:none}.sheet{padding:0;margin:0;box-shadow:none;border-radius:0}}@media (max-width:640px){.sheet{padding:24px 18px;border-top-width:5px}.mark{width:50px;height:50px;font-size:1rem}.meta,.tools{font-size:.8rem}.table td,.table th{padding:10px}}</style></head><body>
<div class="tools"><a class="btn btn-outline-secondary" href="shipment_invoices.php">Back</a> <button class="btn btn-primary" onclick="print()">Print / Save PDF</button></div>
<main class="sheet"><div class="d-flex justify-content-between align-items-start mb-5"><div><?php if($logo):?><img class="logo mb-2" src="<?=url($logo)?>" alt="<?=e($company)?>"><?php else:?><div class="mark mb-2"><?=e(strtoupper(substr($company,0,2)))?></div><?php endif?><h1 class="h2 text-primary fw-bold mb-1"><?=e($company)?></h1><div class="text-secondary"><?=e($tagline)?></div></div><div class="text-end meta"><strong><?=e($r['invoice_status']??'INVOICE')?></strong><div class="fs-5 fw-bold"><?=e($r['invoice_no'])?></div><div>Issued: <?=app_date($r['issue_date'])?></div><div>Due: <?=app_date($r['due_date'])?></div></div></div>
<div class="row mb-5"><div class="col"><small class="text-secondary fw-bold">BILL TO</small><h5 class="mt-2"><?=e($r['sender'])?></h5><div><?=e($r['tell'])?></div><div>Receiver: <?=e($r['receiver'])?></div></div><div class="col text-end"><small class="text-secondary fw-bold">SHIPMENT</small><h5 class="mt-2"><?=e($r['awb'])?></h5><div><?=app_date($r['shipment_date'])?></div><div class="statusline"><?=e($r['origin_branch'])?> → <?=e($r['dest_branch']?:$r['origin_branch'])?></div></div></div>
<table class="table"><thead><tr><th>Description</th><th>Pieces</th><th>KG</th><th>Rate</th><th>Extra</th><th class="text-end">Amount</th></tr></thead><tbody><tr><td><?=e($r['description'])?></td><td><?=e($r['pcs'])?> PCS</td><td><?=e($r['kg'])?> KG</td><td><?=money($r['rate'])?></td><td><?=money($r['extra'])?></td><td class="text-end"><?=money($r['subtotal'])?></td></tr></tbody><tfoot><tr><th colspan="5" class="text-end">Cargo Amount</th><th class="text-end"><?=money($r['subtotal'])?></th></tr><?php if($discount>0):?><tr class="discount"><th colspan="5" class="text-end">Discount</th><th class="text-end">− <?=money($discount)?></th></tr><?php endif?><tr><th colspan="5" class="text-end">Total Amount</th><th class="text-end"><?=money($invoiceTotal)?></th></tr><tr><th colspan="5" class="text-end text-success">Amount Paid</th><th class="text-end text-success"><?=money($paid)?></th></tr><tr class="total"><th colspan="5" class="text-end">Balance Due</th><th class="text-end"><?=money($balance)?></th></tr></tfoot></table>
<?php if($qr):?><div class="qr"><img src="<?=e($qr)?>" alt="Company address QR code"></div><?php endif?>
<div class="mt-4"><small class="text-secondary fw-bold">NOTE</small><p class="mb-0"><?=nl2br(e($r['notes']?:'No additional notes.'))?></p></div><div class="footer"><span>Thank you for choosing <?=e($company)?>.</span><span><?=e($r['invoice_no'])?></span></div></main></body></html>
